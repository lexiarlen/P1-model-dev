# This simulation uses fix deform to apply a shear forcing to all particles 
# via a body force. Index variables permit ensemble simulations. 

### -------------------------------- variables ---------------------------------- ###

# ensemble config
variable L_pack             index '100'
variable natoms             index 3496

# ice properties / domain
variable L                  equal 100e3                     # [m] domain side length
variable rho_i              equal 920                       # [kg/m^3] ice density
variable r_L                equal ${L}/${L_pack}            # [m] large particle radius
variable r_S                equal floor(3/5*${r_L})         # [m] small particle radius
variable knb                equal 1e9                       # [N/m] bond stiffness
variable knc                equal 1e5                       # [N/m] contact stiffness
variable rmax_multiplier    equal 1.5                       # [-] maximum bonding distance multiplier FIX
variable sig                equal 75000                     # [N/m] bond "strength" 

# ice properties derived
variable r_LS               equal (${r_L}+${r_S})/2         # [m] combined large and small particle radii
variable d_L                equal ${r_L}*2                  # [m] large particle diameter
variable d_S                equal ${r_S}*2                  # [m] small particle diameter
variable d_LS               equal (${d_S}+${d_L})/2         # [m] combined large and small particle diameters

variable rmax_S             equal ${rmax_multiplier}*${d_S}      
variable rmax_LS            equal ${rmax_multiplier}*${d_LS}
variable rmax_L             equal ${rmax_multiplier}*${d_L}

variable m_L                equal PI*${r_L}^2*${rho_i}     # [kg] large particle mass
variable m_S                equal PI*${r_S}^2*${rho_i}     # [kg] small particle mass

variable eps_crit           equal ${sig}/${knb}            # [-] critical strain

variable dampc              equal sqrt(${m_S}*${knc})      # [kg/s] contact damping
variable dampb              equal sqrt(${m_S}*${knb})      # [kg/s] bond damping

variable av_L               equal 50*${knc}/(2*${r_L})^2   # [kg/m^2/s^2] large particle contact anharmonic coeff
variable av_LS              equal 50*${knc}/(2*${r_LS})^2  # [kg/m^2/s^2] large and small particle contact anharmonic coeff
variable av_S               equal 50*${knc}/(2*${r_S})^2   # [kg/m^2/s^2] small particle contact anharmonic coeff

# initial conditions
variable atomfile_dir       index '/path/to/atomfiles/'

# forcing
variable shear_rate         equal 1e-7

# numerics
variable comm_dist          equal 6*${r_L}                   # [m] communication distance
variable neigh_bin_ini      equal ${rmax_multiplier}*${r_L}  # [m] initial neighbor bin distance for bonding; reduce to r_L later
variable dt                 equal 0.1*sqrt(${m_S}/${knb})    # [s] from Clemmer et al 2025                  
variable run_time           equal 0.5*3600                   # [s] runtime

# output
variable out_dir            index "/path/to/dumped/data/"
shell mkdir ${out_dir}
variable outfile_name       index "xxx.lammps"

variable num_timesteps      equal floor(${run_time}/${dt})                  # CHNAGE TO CEILING?
variable num_dumps          equal 200                                       # FIX
variable dump_freq          equal floor(${num_timesteps}/${num_dumps})
variable thermo_freq        equal 20*${dump_freq}

### -------------------------------- simulation setup ---------------------------------- ###

# setup
units               si
dimension           2
boundary            p p p
atom_style          bond
newton              on off                               
comm_modify         vel yes cutoff ${comm_dist}
special_bonds       lj 0.0 1.0 1.0 coul 0.0 1.0 1.0
processors          * * *

# create domain
region              domain prism 0 ${L} 0 ${L} -${d_S} ${d_S} 0 0 0 units box
create_box          2 domain bond/types 1 extra/bond/per/atom 16 extra/special/per/atom 48

# create particles by random insertion followed by position assignment
create_atoms        1 random ${natoms} 12908741 domain              

variable xpos       atomfile ${atomfile_dir}x.data 
variable ypos       atomfile ${atomfile_dir}y.data 
variable atomtype   atomfile ${atomfile_dir}type.data 

set                 group all type v_atomtype x v_xpos y v_ypos z 0
mass 1              ${m_L}
mass 2              ${m_S}

# for radii dumps
group               all_large type 1
group               all_small type 2
variable            r atom gmask(all_large)*(${r_L}-${r_S})+${r_S}

# setup contacts
neighbor            ${neigh_bin_ini} bin

pair_style          bpm/spring anharmonic yes
pair_coeff          1 1 ${knc} ${d_L}  ${dampc} ${av_L}
pair_coeff          1 2 ${knc} ${d_LS} ${dampc} ${av_LS}
pair_coeff          2 2 ${knc} ${d_S}  ${dampc} ${av_S}

# install bonds
fix                 integrate_all all nve 
timestep            ${dt}
create_bonds        many all_large all_large 1 0 ${rmax_L}
create_bonds        many all_large all_small 1 0 ${rmax_LS}
create_bonds        many all_small all_small 1 0 ${rmax_S}
unfix integrate_all

# set bond style
neighbor            ${r_L} bin
special_bonds       lj/coul 0.0 1.0 1.0 coul 1.0 1.0 1.0 #
bond_style          bpm/spring overlay/pair no smooth yes normalize no volume/factor no
bond_coeff          1 ${knb} ${eps_crit} ${dampb} 

# global computes & fixes
fix                 2d_sim all enforce2d
compute             nbond  all nbond/atom
compute             tbond all reduce sum c_nbond
compute             bondsdump all property/local batom1 batom2
compute             peratom_stress all stress/atom NULL
variable            sxx atom c_peratom_stress[1]/(PI*v_r^2) # assuming small deformation
variable            sxy atom c_peratom_stress[4]/(PI*v_r^2)
variable            syy atom c_peratom_stress[2]/(PI*v_r^2)
run 0
fix                 ini_bonds all store/state 0 c_nbond
variable            nb_diff atom c_nbond-f_ini_bonds
run 1

fix                 integrate_all all nve
reset_timestep 0

### -------------------------------- shear box ---------------------------------- ###
fix  shear all deform 1 xy erate ${shear_rate} units box remap x

thermo_style        custom atoms step time cpu ke c_tbond 
thermo              ${thermo_freq}
thermo_modify       lost ignore lost/bond ignore norm no

dump                1 all custom ${dump_freq} ${out_dir}${outfile_name} id type x y vx vy fx fy v_r c_nbond v_nb_diff v_sxx v_sxy v_syy c_peratom_stress[4]

run                 ${num_timesteps} 
